# Copy this file to ".env" and replace every CHANGE_ME value. NEVER commit .env.
# Avoid spaces and shell special characters in values.

DB_NAME=queueless
DB_USER=queueless
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password

# At least 32 characters, random. Used to sign login tokens (JWT).
JWT_SECRET=CHANGE_ME_to_a_long_random_string_32_chars_min

# The first administrator account created on first start
ADMIN_EMAIL=admin@queueless.local
ADMIN_PASSWORD=CHANGE_ME_admin_password

APP_TIMEZONE=Asia/Kolkata
FRONTEND_PORT=8080
